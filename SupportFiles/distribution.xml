<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>Mac AI Helper</title>
    <organization>com.castloud</organization>
    <domains enable_localSystem="true"/>
    <options customize="never" require-scripts="false" hostArchitectures="x86_64,arm64"/>

    <!-- Require macOS 14.0 (Sonoma) or later -->
    <volume-check>
        <allowed-os-versions>
            <os-version min="14.0"/>
        </allowed-os-versions>
    </volume-check>

    <!-- Welcome / description shown in the installer -->
    <welcome file="welcome.html" mime-type="text/html"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>

    <!-- Reference to the component package built by pkgbuild -->
    <pkg-ref id="com.castloud.MacAIHelper"/>

    <choices-outline>
        <line choice="default">
            <line choice="com.castloud.MacAIHelper"/>
        </line>
    </choices-outline>

    <choice id="default"/>

    <choice id="com.castloud.MacAIHelper"
            visible="false"
            title="Mac AI Helper"
            description="A native macOS menu bar AI assistant">
        <pkg-ref id="com.castloud.MacAIHelper"/>
    </choice>

    <pkg-ref id="com.castloud.MacAIHelper"
             version="0"
             onConclusion="none">MacAIHelper-component.pkg</pkg-ref>
</installer-gui-script>
